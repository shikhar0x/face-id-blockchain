SERPAPI_KEY=

# Person 3 — Blockchain Configuration
USE_LOCAL_BLOCKCHAIN=true
RPC_URL=
CONTRACT_ADDRESS=
PRIVATE_KEY=

# Person 1 — Face Processing & Matching
# Cosine-similarity threshold for a valid match (higher = stricter).
# Demo default: 0.5. Calibrate on real pairs if needed (typical range 0.4-0.6).
FACE_MATCH_THRESHOLD=0.5
# Directory holding the downloaded YuNet/SFace .onnx models.
FACE_MODEL_DIR=models
# YuNet detector confidence threshold (faces below this are ignored).
FACE_DETECT_THRESHOLD=0.6
# Set to 0 to disable automatic model download (fail fast instead).
FACE_AUTO_DOWNLOAD=1
# Optional explicit model paths (override FACE_MODEL_DIR):
# FACE_YUNET_MODEL=models/face_detection_yunet_2023mar.onnx
# FACE_SFACE_MODEL=models/face_recognition_sface_2021dec.onnx
